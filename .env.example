# Copie este arquivo para ".env" e preencha. NUNCA commite o ".env".
# Linhas de comentario devem comecar com "#" (comentario no fim da linha nao e suportado).

# Token do seu bot (crie um no @BotFather, no Telegram).
TELEGRAM_TOKEN=

# IDs de usuario do Telegram autorizados a controlar o bot, separados por virgula.
# Vazio = ninguem e autorizado. Descubra o seu ID mandando /id para o bot.
ALLOWED_USER_IDS=

# Parte do titulo da janela do jogo. Descubra o titulo certo com:
#   python -m league_bot windows
SLAYER_WINDOW_TITLE=Slayer Legend

# --- Opcionais (os valores abaixo sao os padroes) ---
# SLAYER_LAUNCH_URI=googleplaygames://launch/?id=com.gear2.growslayer&lid=1&pid=1
# SLAYER_PLAY_GAMES_EXE=
# SLAYER_PROCESS_NAMES=client.exe,crosvm.exe
# SLAYER_START_MACRO=start_game
# SLAYER_MACROS_DIR=
# SLAYER_DATA_DIR=
# SLAYER_FOREGROUND_INPUT=1
# SLAYER_MAX_COMMAND_AGE=300
# SLAYER_LOG_FILE=
